diff -uNr a/src/com/android/settings/fuelgauge/EpadChargeModePreferenceController.java b/src/com/android/settings/fuelgauge/EpadChargeModePreferenceController.java
--- a/src/com/android/settings/fuelgauge/EpadChargeModePreferenceController.java	1970-01-01 01:00:00.000000000 +0100
+++ b/src/com/android/settings/fuelgauge/EpadChargeModePreferenceController.java	2026-11-02 22:50:52.265694676 +0100
@@ -0,0 +1,62 @@
+/*
+ * E-PAD: modo de carga. init aplica persist.vendor.epad.charge_mode al cargador (bq24190) y al driver de
+ * batería: normal (100 %), limit80 (hasta 80 %) o plugged (se mantiene entre 45 y 55 % y la tablet se alimenta
+ * del cable).
+ */
+package com.android.settings.fuelgauge;
+
+import android.content.Context;
+import android.os.SystemProperties;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.core.BasePreferenceController;
+
+public class EpadChargeModePreferenceController extends BasePreferenceController
+        implements Preference.OnPreferenceChangeListener {
+    private static final String PROP = "persist.vendor.epad.charge_mode";
+
+    public EpadChargeModePreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        Preference p = screen.findPreference(getPreferenceKey());
+        if (p != null) {
+            p.setOnPreferenceChangeListener(this);
+        }
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        super.updateState(preference);
+        ListPreference list = (ListPreference) preference;
+        list.setValue(SystemProperties.get(PROP, "normal"));
+        if (list.getEntry() == null) {
+            list.setValueIndex(0);
+        }
+        list.setSummary(list.getEntry() == null ? null : list.getEntry().toString().replace("%", "%%"));
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        try {
+            SystemProperties.set(PROP, (String) newValue);
+        } catch (RuntimeException e) {
+            return false;
+        }
+        ListPreference list = (ListPreference) preference;
+        list.setValue((String) newValue);
+        list.setSummary(list.getEntry() == null ? null : list.getEntry().toString().replace("%", "%%"));
+        return false;
+    }
+}
