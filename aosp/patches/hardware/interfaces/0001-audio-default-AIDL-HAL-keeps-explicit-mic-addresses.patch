From: bluelightsaber <26096600+bluelightsaber@users.noreply.github.com>
Subject: [PATCH] audio: default AIDL HAL keeps explicit built-in mic addresses

The XML converter replaced any built-in mic address with "bottom", so
StreamPrimary could never be pointed at another ALSA capture PCM.

---
diff --git a/audio/aidl/default/XsdcConversion.cpp b/audio/aidl/default/XsdcConversion.cpp
index fbda7aa..761c6f6 100644
--- a/audio/aidl/default/XsdcConversion.cpp
+++ b/audio/aidl/default/XsdcConversion.cpp
@@ -236,6 +236,8 @@ ConversionResult<AudioDevice> createAudioDevice(
                                ? AudioDeviceAddress::make<AudioDeviceAddress::Tag::id>(
                                          xDevicePort.getAddress())
                                : AudioDeviceAddress{}};
+    // An explicit address is kept: StreamPrimary takes the ALSA card/device from "CARD_x_DEV_y".
+    if (xDevicePort.hasAddress()) return device;
     if (device.type.type == AudioDeviceType::IN_MICROPHONE && device.type.connection.empty()) {
         device.address = "bottom";
     } else if (device.type.type == AudioDeviceType::IN_MICROPHONE_BACK &&
