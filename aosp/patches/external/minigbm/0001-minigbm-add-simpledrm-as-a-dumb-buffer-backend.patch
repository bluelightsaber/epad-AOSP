From d994f6ab263e6848a4bdf83a3bee9de32f4b00fd Mon Sep 17 00:00:00 2001
From: bluelightsaber <26096600+bluelightsaber@users.noreply.github.com>
Date: Fri, 30 Oct 2026 08:20:39 +0100
Subject: [PATCH] minigbm: add simpledrm as a dumb-buffer backend

The Eewrite E-PAD (E-Ink, MT6797) scans out lk's framebuffer through simpledrm
and renders in software; allocate dumb buffers from it like the other generic
KMS-only drivers.

Change-Id: If33a683d5220d95d0a806db9fcc033a4a11429dd
---
 drv.c         | 5 +++--
 dumb_driver.c | 1 +
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/drv.c b/drv.c
index b74ed99ff..b12dd56c1 100644
--- a/drv.c
+++ b/drv.c
@@ -53,6 +53,7 @@ extern const struct backend backend_nouveau;
 extern const struct backend backend_komeda;
 extern const struct backend backend_radeon;
 extern const struct backend backend_rockchip;
+extern const struct backend backend_simpledrm;
 extern const struct backend backend_sun4i_drm;
 extern const struct backend backend_synaptics;
 extern const struct backend backend_virtgpu;
@@ -79,8 +80,8 @@ static const struct backend *drv_backend_list[] = {
 #endif
 	&backend_evdi,	    &backend_komeda,	&backend_marvell, &backend_mediatek,
 	&backend_meson,	    &backend_nouveau,	&backend_radeon,  &backend_rockchip,
-	&backend_sun4i_drm, &backend_synaptics, &backend_udl,	  &backend_virtgpu,
-	&backend_vkms,	    &backend_mock
+	&backend_simpledrm, &backend_sun4i_drm, &backend_synaptics, &backend_udl,
+	&backend_virtgpu,   &backend_vkms,	&backend_mock
 };
 
 void drv_preload(bool load)
diff --git a/dumb_driver.c b/dumb_driver.c
index 98c9ba7fb..4055781c0 100644
--- a/dumb_driver.c
+++ b/dumb_driver.c
@@ -71,6 +71,7 @@ INIT_DUMB_DRIVER(marvell)
 INIT_DUMB_DRIVER(meson)
 INIT_DUMB_DRIVER(nouveau)
 INIT_DUMB_DRIVER(radeon)
+INIT_DUMB_DRIVER(simpledrm)
 INIT_DUMB_DRIVER_WITH_NAME(sun4i_drm, "sun4i-drm")
 INIT_DUMB_DRIVER(synaptics)
 INIT_DUMB_DRIVER(udl)
