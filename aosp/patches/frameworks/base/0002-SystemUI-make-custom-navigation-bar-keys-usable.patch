From b092686413299e7d9495a29675f60aaa718441c5 Mon Sep 17 00:00:00 2001
From: bluelightsaber <26096600+bluelightsaber@users.noreply.github.com>
Date: Sat, 7 Nov 2026 21:08:59 +0100
Subject: [PATCH] SystemUI: make custom navigation bar keys usable

key(CODE:URI) buttons of the navigation bar layout did not work:

- KeyButtonView.loadAsync() hands the loaded Icon drawable straight to setImageDrawable(),
  which casts it to KeyButtonDrawable: SystemUI crash-loops with a ClassCastException. Wrap
  the icon in a KeyButtonDrawable.
- custom_key.xml tints the key white and custom keys never get the dark intensity, so they
  are invisible on a light navigation bar. Drop the tint and draw them black (E-PAD only).
- The injected key event skips the input filter, so an accessibility service cannot pick it
  up. A device can set config_navBarCustomKeyReceiver to a package that gets the press as a
  com.android.systemui.action.NAV_BAR_CUSTOM_KEY broadcast (extra "keycode") instead.
- Icons are loaded once. Watch the content URI so a provider can change the icon by notifying.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I9e82d1146f8406c397b01bc6d470c29da42c333c
---
 packages/SystemUI/res/values/config.xml       |  5 ++
 .../views/buttons/KeyButtonView.java          | 71 +++++++++++++++++++
 2 files changed, 76 insertions(+)

diff --git a/packages/SystemUI/res/values/config.xml b/packages/SystemUI/res/values/config.xml
index f1d7ed35d..ddd48f038 100644
--- a/packages/SystemUI/res/values/config.xml
+++ b/packages/SystemUI/res/values/config.xml
@@ -388,6 +388,11 @@
     <string name="config_navBarLayoutQuickstep" translatable="false">back[1.7WC];home;contextual[1.7WC]</string>
     <string name="config_navBarLayoutHandle" translatable="false">back[70AC];home_handle;ime_switcher[70AC]</string>
 
+    <!-- Package that receives com.android.systemui.action.NAV_BAR_CUSTOM_KEY (extra "keycode")
+         when a key(CODE:URI) button of the navigation bar is pressed, instead of the injected key
+         event. Empty: the key event is injected as usual. -->
+    <string name="config_navBarCustomKeyReceiver" translatable="false"></string>
+
     <!-- Whether to show a warning notification when device's skin temperature is high. -->
     <integer name="config_showTemperatureWarning">0</integer>
 
diff --git a/packages/SystemUI/src/com/android/systemui/navigationbar/views/buttons/KeyButtonView.java b/packages/SystemUI/src/com/android/systemui/navigationbar/views/buttons/KeyButtonView.java
index 559d75f2c..5a8ceaa07 100644
--- a/packages/SystemUI/src/com/android/systemui/navigationbar/views/buttons/KeyButtonView.java
+++ b/packages/SystemUI/src/com/android/systemui/navigationbar/views/buttons/KeyButtonView.java
@@ -24,9 +24,12 @@ import static android.view.accessibility.AccessibilityNodeInfo.ACTION_LONG_CLICK
 import android.annotation.Nullable;
 import android.app.ActivityManager;
 import android.content.Context;
+import android.content.Intent;
 import android.content.res.Configuration;
 import android.content.res.TypedArray;
+import android.database.ContentObserver;
 import android.graphics.Canvas;
+import android.graphics.Color;
 import android.graphics.Paint;
 import android.graphics.drawable.Drawable;
 import android.graphics.drawable.Icon;
@@ -36,7 +39,10 @@ import android.media.AudioManager;
 import android.metrics.LogMaker;
 import android.os.AsyncTask;
 import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
 import android.os.SystemClock;
+import android.os.UserHandle;
 import android.util.AttributeSet;
 import android.util.Log;
 import android.util.TypedValue;
@@ -192,8 +198,17 @@ public class KeyButtonView extends ImageView implements ButtonInterface {
         return mCode != KEYCODE_UNKNOWN || super.isClickable();
     }
 
+    /** Sent instead of the key event by custom keys when config_navBarCustomKeyReceiver is set. */
+    public static final String ACTION_NAV_BAR_CUSTOM_KEY =
+            "com.android.systemui.action.NAV_BAR_CUSTOM_KEY";
+    public static final String EXTRA_KEYCODE = "keycode";
+
+    private boolean mIsCustomKey;
+
     public void setCode(int code) {
         mCode = code;
+        // Only key(CODE:URI) buttons of the layout get their code here.
+        mIsCustomKey = true;
     }
 
     @Override
@@ -206,7 +221,42 @@ public class KeyButtonView extends ImageView implements ButtonInterface {
         mNavBarButtonClickLogger = navBarButtonClickLogger;
     }
 
+    /** Custom key icon served by a content URI: reloaded when the provider notifies a change. */
+    private Icon mObservedIcon;
+    private final ContentObserver mIconObserver =
+            new ContentObserver(new Handler(Looper.getMainLooper())) {
+                @Override
+                public void onChange(boolean selfChange) {
+                    if (mObservedIcon != null) {
+                        loadAsync(mObservedIcon);
+                    }
+                }
+            };
+
+    @Override
+    public void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        if (mObservedIcon != null) {
+            mContext.getContentResolver().registerContentObserver(mObservedIcon.getUri(), false,
+                    mIconObserver);
+            loadAsync(mObservedIcon);
+        }
+    }
+
+    @Override
+    public void onDetachedFromWindow() {
+        mContext.getContentResolver().unregisterContentObserver(mIconObserver);
+        super.onDetachedFromWindow();
+    }
+
     public void loadAsync(Icon icon) {
+        if (mObservedIcon == null && icon.getType() == Icon.TYPE_URI) {
+            mObservedIcon = icon;
+            if (isAttachedToWindow()) {
+                mContext.getContentResolver().registerContentObserver(icon.getUri(), false,
+                        mIconObserver);
+            }
+        }
         new AsyncTask<Icon, Void, Drawable>() {
             @Override
             protected Drawable doInBackground(Icon... params) {
@@ -215,6 +265,16 @@ public class KeyButtonView extends ImageView implements ButtonInterface {
 
             @Override
             protected void onPostExecute(Drawable drawable) {
+                // Icons of custom keys come as plain drawables; setImageDrawable() expects a
+                // KeyButtonDrawable, so wrap them. custom_key.xml also sets a fixed white tint,
+                // invisible on a light navigation bar: drop it. Custom keys belong to no
+                // ButtonDispatcher, so they never get the dark intensity: the E-PAD bar is always
+                // light, use black for both.
+                if (drawable != null && !(drawable instanceof KeyButtonDrawable)) {
+                    drawable = new KeyButtonDrawable(drawable, Color.BLACK, Color.BLACK, false,
+                            null);
+                    setImageTintList(null);
+                }
                 setImageDrawable(drawable);
             }
         }.execute(icon);
@@ -443,6 +503,17 @@ public class KeyButtonView extends ImageView implements ButtonInterface {
                 .addTaggedData(MetricsEvent.FIELD_NAV_ACTION, action)
                 .addTaggedData(MetricsEvent.FIELD_FLAGS, flags));
         logSomePresses(action, flags);
+        // Injected key events skip the input filter, so an accessibility service never sees
+        // them: a device can ask for custom keys to reach an app as a broadcast instead.
+        final String receiver = mContext.getString(R.string.config_navBarCustomKeyReceiver);
+        if (mIsCustomKey && !receiver.isEmpty()) {
+            if (action == KeyEvent.ACTION_UP && (flags & KeyEvent.FLAG_CANCELED) == 0) {
+                mContext.sendBroadcastAsUser(new Intent(ACTION_NAV_BAR_CUSTOM_KEY)
+                        .setPackage(receiver)
+                        .putExtra(EXTRA_KEYCODE, mCode), UserHandle.CURRENT);
+            }
+            return;
+        }
         if (mCode == KeyEvent.KEYCODE_BACK && flags != KeyEvent.FLAG_LONG_PRESS) {
             Log.i(TAG, "Back button event: " + KeyEvent.actionToString(action));
         }
-- 
