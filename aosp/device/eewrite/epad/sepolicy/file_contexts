# Particiones de Android en la microSD (MSDC1, 11240000.mmc)
/dev/block/platform/11240000\.mmc/by-name/metadata	u:object_r:metadata_block_device:s0
/dev/block/platform/11240000\.mmc/by-name/super		u:object_r:super_block_device:s0
/dev/block/platform/11240000\.mmc/by-name/userdata	u:object_r:userdata_block_device:s0
/dev/block/zram0					u:object_r:swap_block_device:s0

# Pantalla: simpledrm (framebuffer de lk) y el control del T1000 (compatible con el /dev/t1000 de fábrica)
/dev/dri				u:object_r:dri_device:s0
/dev/dri/card0				u:object_r:graphics_device:s0
/dev/t1000				u:object_r:epad_t1000_device:s0

# Gráficos: minigbm (asignador AIDL y mapper) sobre los búferes «dumb» de simpledrm
/vendor/bin/hw/android\.hardware\.graphics\.allocator-service\.minigbm	u:object_r:hal_graphics_allocator_default_exec:s0
/vendor/lib(64)?/hw/mapper\.minigbm\.so					u:object_r:same_process_hal_file:s0

# KeyMint por software
/vendor/bin/hw/android\.hardware\.security\.keymint-service\.nonsecure	u:object_r:hal_keymint_default_exec:s0

# GPS: HAL AIDL propio (dominio del HAL de ejemplo) y mnld de fábrica
/vendor/bin/hw/android\.hardware\.gnss-service\.epad	u:object_r:hal_gnss_default_exec:s0
/vendor/gps/mnld					u:object_r:mnld_exec:s0
/dev/stpgps						u:object_r:gps_device:s0
/dev/gps						u:object_r:gps_device:s0
/vendor/bin/epad-audio-mixer u:object_r:epad_audio_mixer_exec:s0
/dev/block/platform/112[34]0000\.mmc/by-name/epad_metadata	u:object_r:metadata_block_device:s0
/dev/block/platform/112[34]0000\.mmc/by-name/epad_data	u:object_r:userdata_block_device:s0
/dev/block/platform/11230000\.mmc/by-name/super		u:object_r:super_block_device:s0
